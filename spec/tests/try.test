# try.test - `try`, `catch`, `error` and error messages.
# Format and comparison rule: see README.md.

try .foo
42

try .foo
{"foo":"bar"}
"bar"

try error catch .
"custom error"
"custom error"

.foo?
{"foo":1}
1

try error
"test"

try (try error catch error) catch .
"nested"
"nested"

try (42 | error) catch .
null
42

try (null | error) catch .
null
null

try ([1,2] | error) catch .
null
[1,2]

try (true | error) catch .
null
true

try (.foo | .bar) catch .
42
"Cannot index number with string (\"foo\")"

try ("hello" | error) catch .
null
"hello"

# From the evidence of the jqlite plan.
[try (1, error("x"), 3) catch .]
null
[1,"x"]

# From the evidence of the jqlite plan.
try ("{" | fromjson) catch "caught"
null
"caught"

# Errors of the consumer are not errors of the producer (spec §6.2).
"x" | try ((try . catch "too much") | error) catch "right"
null
"right"

[try ((try (1,2) catch "inner") | if . == 2 then error("consumer") else . end) catch ("outer: " + .)]
null
[1,"outer: consumer"]

[.[] | try if . == 2 then error("e") else . end catch "c"]
[1,2,3]
[1,"c",3]

try [(1, error("x")) // 3] catch .
null
"x"

[(null, false) // 3]
null
[3]
