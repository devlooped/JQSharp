[[2015,0,0,0,0,0,3,63],[2015,0,0,0,0,0,3,0],[2016,0,0,0,0,0,4,365],"date \"367 2016\" does not match format \"%j %Y\"","date \"0 2015\" does not match format \"%j %Y\""]

[.[] | try strptime("%Y %z") catch .]
["2015 +0200", "2015 -02:30", "2015 Z", "2015 +02", "2015 +2", "2015 0200"]
[[2015,0,0,0,0,0,3,-1],[2015,0,0,0,0,0,3,-1],[2015,0,0,0,0,0,3,-1],[2015,0,0,0,0,0,3,-1],"date \"2015 +2\" does not match format \"%Y %z\"","date \"2015 0200\" does not match format \"%Y %z\""]

[.[] | try strptime("%Y %Z") catch .]
