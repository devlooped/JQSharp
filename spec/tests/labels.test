# labels.test - `label` and `break`.
# Format and comparison rule: see README.md.

[(label $here | .[] | if .>1 then break $here else . end), "hi!"]
[0,1,2]
[0,1,"hi!"]

[(label $here | .[] | if .>1 then break $here else . end), "hi!"]
[0,2,1]
[0,"hi!"]

[label $out | foreach .[] as $item ([3, null]; if .[0] < 1 then break $out else [.[0] -1, $item] end; .[1])]
[11,22,33,44,55,66,77,88,99]
[11,22,33]

[label $x | 1, break $x, 2]
null
[1]

[label $x | 1,2,3]
null
[1,2,3]

# jq 1.8.2 prints 0, 99: its `break` is an internal error that `try` catches.
# In jqlite `break` is not an error, so `try` does not see it.
label $out | try (0, break $out, 1) catch 99
null
0

%%FAIL
. as $foo | break $foo
$*label-foo is not defined

label $out | foreach .[] as $x (0; . + $x; if . > 3 then ., break $out else . end)
[1,2,3,5]
1
3
6

# From the evidence of the jqlite plan.
[label $f | def g: break $f; (label $f | 1, g, 2), 3]
null
[1]
