[0,43200,46800,3600,82800,59.9]
["00:00:00 12 AM","12:00:00 12 PM","13:00:00 01 PM","01:00:00 01 AM","23:00:00 11 PM","00:00:59 12 AM"]

# A broken-down time is normalized like mktime first; negative years print as -0001.
[.[] | strftime("%Y-%m-%d %j %a %C %x %s")]
[[2015,14,1,0,0,0,0,0],[2016,1,29,0,0,0,9,9],[2015,0,0],[1900,0,1,0,0,0],[2015,2,5,23,51,47.5,0,0],[-1,0,1],[2015,2,5,23,51,-0.5]]
["2016-03-01 061 Tue 20 03/01/16 1456790400","2016-02-29 060 Mon 20 02/29/16 1456704000","2014-12-31 365 Wed 20 12/31/14 1419984000","1900-01-01 001 Mon 19 01/01/00 -2208988800","2015-03-05 064 Thu 20 03/05/15 1425599507","-0001-01-01 001 Fri -01 01/01/99 -62198755200","2015-03-05 064 Thu 20 03/05/15 1425599460"]

[.[] | try gmtime catch .]
["a", null, 1e16, -1e16, 9007199254740992]
["gmtime requires numeric inputs","gmtime requires numeric inputs","error converting number of seconds since epoch to datetime","error converting number of seconds since epoch to datetime","error converting number of seconds since epoch to datetime"]

[nan, infinite, -infinite] | map(try gmtime catch .)
null
["error converting number of seconds since epoch to datetime","error converting number of seconds since epoch to datetime","error converting number of seconds since epoch to datetime"]

[.[] | try localtime catch .]
["a"]
["localtime requires numeric inputs"]

[.[] | try mktime catch .]
["a", 1, null, {}, ["a"], [2015,"a"], [2015,2,5,null]]
["mktime requires array inputs","mktime requires array inputs","mktime requires array inputs","mktime requires array inputs","mktime requires parsed datetime inputs","mktime requires parsed datetime inputs","mktime requires parsed datetime inputs"]

[.[] | try strftime("%Y") catch .]
["a", null, {}, ["a"]]
["strftime/1 requires parsed datetime inputs","strftime/1 requires parsed datetime inputs","strftime/1 requires parsed datetime inputs","strftime/1 requires parsed datetime inputs"]

try strftime(1) catch .
0
"strftime/1 requires a string format"

# Spec 13 (Dates row): an unknown directive is "Unsupported strftime format specifier %<c>"; jq 1.8.2 on
# Windows gives "strftime/1: unknown system failure".
[.[] as $f | try (0 | strftime($f)) catch .]
["%Q", "abc%", "%E"]
["Unsupported strftime format specifier %Q","Invalid format: trailing %","Unsupported strftime format specifier %E"]

[nan, 1e16] | map(try strftime("%Y") catch .)
null
["error converting number of seconds since epoch to datetime","error converting number of seconds since epoch to datetime"]

# strptime by the directive table of 9.12: whitespace, defaults and computed wday/yday (spec 13, Dates row).

[.[] | strptime("%Y-%m-%dT%H:%M:%SZ")]
["2015-03-05T23:51:47Z", "2000-02-29T00:00:00Z", "1970-01-01T00:00:00Z"]
[[2015,2,5,23,51,47,4,63],[2000,1,29,0,0,0,2,59],[1970,0,1,0,0,0,4,0]]

[.[] | try strptime("%Y-%m-%d") catch .]
["2015-03-05", "2015-3-5", " 2015- 3- 5", "2015-03-05 ", "2015-03-05x", "15-03-05", "2015-13-01", "2015-00-01", "2015-03-32", "2015-03-00", "20150-03-05", "x2015-03-05"]
[[2015,2,5,0,0,0,4,63],[2015,2,5,0,0,0,4,63],[2015,2,5,0,0,0,4,63],[2015,2,5,0,0,0,4,63],"date \"2015-03-05x\" does not match format \"%Y-%m-%d\"",[15,2,5,0,0,0,4,63],"date \"2015-13-01\" does not match format \"%Y-%m-%d\"","date \"2015-00-01\" does not match format \"%Y-%m-%d\"","date \"2015-03-32\" does not match format \"%Y-%m-%d\"","date \"2015-03-00\" does not match format \"%Y-%m-%d\"","date \"20150-03-05\" does not match format \"%Y-%m-%d\"","date \"x2015-03-05\" does not match format \"%Y-%m-%d\""]

[.[] | try strptime("%d %b %Y") catch .]
["05 Mar 2015", "5 march 2015", "05 MAR 2015", "05 Sept 2015", "05 Sep 2015", "05  Mar   2015", "05Mar2015"]
[[2015,2,5,0,0,0,4,63],[2015,2,5,0,0,0,4,63],[2015,2,5,0,0,0,4,63],"date \"05 Sept 2015\" does not match format \"%d %b %Y\"",[2015,8,5,0,0,0,6,247],[2015,2,5,0,0,0,4,63],[2015,2,5,0,0,0,4,63]]

[.[] | try strptime("%A, %B %e %Y") catch .]
["Thursday, March  5 2015", "thu, mar 5 2015", "Sunday, March 5 2015", "Thurs, March 5 2015"]
[[2015,2,5,0,0,0,4,63],[2015,2,5,0,0,0,4,63],[2015,2,5,0,0,0,0,63],"date \"Thurs, March 5 2015\" does not match format \"%A, %B %e %Y\""]

[.[] | try strptime("%H:%M:%S") catch .]
["23:59:60", "24:00:00", "1:2:3", "00:60:00"]
[[1900,0,0,23,59,60,0,-1],"date \"24:00:00\" does not match format \"%H:%M:%S\"",[1900,0,0,1,2,3,0,-1],"date \"00:60:00\" does not match format \"%H:%M:%S\""]

[.[] | try strptime("%j %Y") catch .]
