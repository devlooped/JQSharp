# From the evidence of the jqlite plan.
[range(40) | {a: (. % 3), b: .}] | sort_by(.a) | map(.b)
null
[0,3,6,9,12,15,18,21,24,27,30,33,36,39,1,4,7,10,13,16,19,22,25,28,31,34,37,2,5,8,11,14,17,20,23,26,29,32,35,38]

# From the evidence of the jqlite plan.
[range(40) | {a: (. % 3), b: .}] | group_by(.a) | map(map(.b))
null
[[0,3,6,9,12,15,18,21,24,27,30,33,36,39],[1,4,7,10,13,16,19,22,25,28,31,34,37],[2,5,8,11,14,17,20,23,26,29,32,35,38]]

# From the evidence of the jqlite plan.
[range(40) | {a: (. % 3), b: .}] | unique_by(.a) | map(.b)
null
[0,1,2]

# From the evidence of the jqlite plan.
[range(40) | {a: (. % 3), b: .}] | min_by(.a), max_by(.a)
null
{"a":0,"b":0}
{"a":2,"b":38}

# _sort_by_impl, _group_by_impl, _min_by_impl, _max_by_impl: the input and its keys are arrays of equal length, else an error.

[[3,1,2] | _sort_by_impl([[2],[0],[1]]), _group_by_impl([[1],[0],[1]]), _min_by_impl([[2],[0],[0]]), _max_by_impl([[2],[0],[2]])]
null
[[1,2,3],[[1],[3,2]],1,2]

[.[] as [$a, $k] | try ($a | _sort_by_impl($k)) catch .]
[[[1],[1,2]],[[1,2],[1]],[[],[1]],[[1],[]],[[],[]],[[1],"a"],["a",[1]]]
["array ([1]) and array ([1,2]) cannot be sorted, as they are not both arrays","array ([1,2]) and array ([1]) cannot be sorted, as they are not both arrays","array ([]) and array ([1]) cannot be sorted, as they are not both arrays","array ([1]) and array ([]) cannot be sorted, as they are not both arrays",[],"array ([1]) and string (\"a\") cannot be sorted, as they are not both arrays","string (\"a\") and array ([1]) cannot be sorted, as they are not both arrays"]

[.[] as [$a, $k] | try ($a | _group_by_impl($k)) catch .]
[[[1],[1,2]],[[1,2],[1]],[[],[1]],[[1],[]],[[],[]],[[1],"a"],["a",[1]]]
["array ([1]) and array ([1,2]) cannot be sorted, as they are not both arrays","array ([1,2]) and array ([1]) cannot be sorted, as they are not both arrays","array ([]) and array ([1]) cannot be sorted, as they are not both arrays","array ([1]) and array ([]) cannot be sorted, as they are not both arrays",[],"array ([1]) and string (\"a\") cannot be sorted, as they are not both arrays","string (\"a\") and array ([1]) cannot be sorted, as they are not both arrays"]

[.[] as [$a, $k] | try ($a | _min_by_impl($k)) catch .]
[[[1],[1,2]],[[1,2],[1]],[[],[1]],[[1],[]],[[],[]],[[1],"a"],["a",[1]]]
["array ([1]) and array ([1,2]) have wrong length","array ([1,2]) and array ([1]) have wrong length","array ([]) and array ([1]) have wrong length","array ([1]) and array ([]) have wrong length",null,"array ([1]) and string (\"a\") cannot be iterated over","string (\"a\") and array ([1]) cannot be iterated over"]

[.[] as [$a, $k] | try ($a | _max_by_impl($k)) catch .]
[[[1],[1,2]],[[1,2],[1]],[[],[1]],[[1],[]],[[],[]],[[1],"a"],["a",[1]]]
["array ([1]) and array ([1,2]) have wrong length","array ([1,2]) and array ([1]) have wrong length","array ([]) and array ([1]) have wrong length","array ([1]) and array ([]) have wrong length",null,"array ([1]) and string (\"a\") cannot be iterated over","string (\"a\") and array ([1]) cannot be iterated over"]

# contains/1: strings, arrays, objects, nesting, kinds (top level: an error; inside: false).

[contains("bar"), contains(""), contains("foobar"), contains("foobarx"), contains("baz")]
"foobar"
[true,true,true,false,false]

[contains("é"), contains("😀b"), contains("\u0000b")]
"aé😀b\u0000b"
[true,true,true]

[contains([]), contains([1]), contains([[2]]), contains([[2,3],1]), contains([4]), contains(["1"])]
[1,[2,3]]
[true,true,true,true,false,false]

[contains(["bar"]), contains(["foo","baz"]), contains(["x"])]
["foobar","baz"]
[true,true,false]

[contains({}), contains({"a":{"b":1}}), contains({"a":{"b":2}}), contains({"a":{"b":1,"c":2}}), contains({"x":null})]
{"a":{"b":1,"c":2}}
[true,true,false,true,false]

[contains({"a":"bar"}), contains({"a":"x"})]
{"a":"foobar"}
[true,false]

[contains({"a":"1"}), contains({"a":[1]}), contains({"a":{}})]
{"a":1}
[false,false,false]

[contains([[1]]), contains(["a"]), contains([{}]), contains([null])]
[{"a":1}, "abc", 1, null]
[false,true,true,true]

[null | contains(null)], [1 | contains(1), contains(2)], [true | contains(true)], [false | contains(false)]
null
[true]
[true,false]
[true]
[true]

[nan | contains(nan)], [[nan] | contains([nan])], [{"a":nan} | contains({"a":nan})]
null
[false]
[false]
[false]

[[1,1] | contains([1,1,1])], [[] | contains([])], [{} | contains({})], ["" | contains("")]
null
[true]
[true]
[true]
[true]

[[true] | contains([false])], [[false] | contains([true])], [[true] | contains([true])]
null
[false]
[false]
[true]

try (true | contains(false)) catch .
null
"boolean (true) and boolean (false) cannot have their containment checked"

try (false | contains(true)) catch .
null
"boolean (false) and boolean (true) cannot have their containment checked"

try (1 | contains("a")) catch .
null
"number (1) and string (\"a\") cannot have their containment checked"

try ([1,2] | contains(1)) catch .
null
"array ([1,2]) and number (1) cannot have their containment checked"

try ({"a":1} | contains([1])) catch .
null
"object ({\"a\":1}) and array ([1]) cannot have their containment checked"

try (null | contains(false)) catch .
null
"null (null) and boolean (false) cannot have their containment checked"

try ("very long string here and more and more" | contains(["very long string here and more"])) catch .
null
"string (\"very long string here an...\") and array ([\"very long string here a...]) cannot have their containment checked"

[contains("b", "z")]
"abc"
[true,false]

[inside("foobar"), inside("xbarx"), inside("ba")]
"bar"
[true,true,false]

try ("a" | inside(1)) catch .
null
"number (1) and string (\"a\") cannot have their containment checked"

[-0 | contains(0)], [0 | contains(-0)], [1.0 | contains(1)]
null
[true]
[true]
[true]

[[[1,2]] | contains([[2]])], [[[1,2]] | contains([[3]])], [[["ab"]] | contains([["b"]])]
null
[true]
[false]
[true]

[JOIN({"a":{"n":1}}; .[]; .k)]
[{"k":"a"},{"k":"b"}]
[[{"k":"a"},{"n":1}],[{"k":"b"},null]]

[JOIN({"a":{"n":1}}; .[]; .k; add)]
[{"k":"a"},{"k":"b"}]
[{"k":"a","n":1},{"k":"b"}]

[JOIN({"1":"x"}; .[]; tostring; .[1])]
[1,2,1]
["x",null,"x"]
