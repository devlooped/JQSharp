# regex.test - Regular expressions: `test`, `match`, `capture`, `scan`, `split`, `splits`, `sub`, `gsub`.
# Format and comparison rule: see README.md.

test("foo")
"foobar"
true

test("foo";"i")
"FoObAr"
true

match("(o+)")
"foobar"
{"offset":1,"length":2,"string":"oo","captures":[{"offset":1,"length":2,"string":"oo","name":null}]}

[match("o";"g")]
"foobar"
[{"offset":1,"length":1,"string":"o","captures":[]},{"offset":2,"length":1,"string":"o","captures":[]}]

match("z")
"foo"

capture("(?<a>\\w+)-(?<b>\\w+)")
"foo-bar"
{"a":"foo","b":"bar"}

capture("(?<a>foo)-(?<b>bar)";"i")
"FOO-bar"
{"a":"FOO","b":"bar"}

[scan("\\d+")]
"abc123def456"
["123","456"]

[scan("([a-z])(\\d+)";"ig")]
"A1b22"
[["A","1"],["b","22"]]

split("\\s+";"")
"a  b  c"
["a","b","c"]

[splits("\\s+")]
"foo bar"
["foo","bar"]

[splits("foo";"i")]
"FOOfoo"
["","",""]

sub("o";"0")
"foo"
"f0o"

sub("o";"0";"i")
"FoO"
"F0O"

sub("(?<x>\\w+)"; .x)
"foo"
"foo"

gsub("o";"0")
"foo"
"f00"

gsub("o";"0";"i")
"FoO"
"F00"

gsub("(?<x>[a-z])(?<n>\\d)"; .n + "-" + .x)
"a1 b2"
"1-a 2-b"

try (test("a")) catch .
123
"number (123) cannot be matched, as it is not a string"

# The flavor, flags, captures, empty matches, code point offsets and the prelude builtins on top of
# match (outputs of jq 1.8.2 unless a comment says otherwise).

try test("(") catch .[:15]
"a"
"Regex failure: "

try test("a{2,1}") catch .[:15]
"a"
"Regex failure: "

# Spec 13 (Regex row): no lookaround; jq 1.8.2 gives true.
try test("(?=a)") catch .[:15]
"a"
"Regex failure: "

try test("a"; "q") catch .
"a"
"q is not a valid modifier string"

try test("a"; "gq") catch .
"a"
"gq is not a valid modifier string"

try test("a"; 1) catch .
"a"
"number (1) is not a string"

try test(1) catch .
"a"
"number not a string or array"

try test(1; null) catch .
"a"
"number (1) is not a string"

try (1 | test("a"; "q")) catch .
null
"number (1) cannot be matched, as it is not a string"

try ("a" | test(1; "q")) catch .
null
"number (1) is not a string"

[test("a"; null), test("A"; "i"), test("a"; "gixnmpsl")]
"a"
[true,true,true]

[match(""; "g") | .offset]
"abc"
[0,1,2,3]

gsub(""; "-")
"abc"
"-a-b-c-"

[match("foo"; "g") | .offset]
"foo bar foo"
[0,8]

[match("."; "g") | [.offset, .length, .string]]
"a😀é"
[[0,1,"a"],[1,1,"😀"],[2,1,"é"]]

[match("(a)|(b)"; "g") | .captures]
"ab"
[[{"offset":0,"length":1,"string":"a","name":null},{"offset":-1,"string":null,"length":0,"name":null}],[{"offset":-1,"string":null,"length":0,"name":null},{"offset":1,"length":1,"string":"b","name":null}]]

match("(?<x>a)?(b)(?<y>c)?")
"b"
{"offset":0,"length":1,"string":"b","captures":[{"offset":-1,"string":null,"length":0,"name":"x"},{"offset":0,"length":1,"string":"b","name":null},{"offset":-1,"string":null,"length":0,"name":"y"}]}

match("(?:(a)|b)+")
"ab"
{"offset":0,"length":2,"string":"ab","captures":[{"offset":0,"length":1,"string":"a","name":null}]}

match("(a)*")
"aaa"
{"offset":0,"length":3,"string":"aaa","captures":[{"offset":2,"length":1,"string":"a","name":null}]}

[match("a*?"; "g") | [.offset, .length]]
"aa"
[[0,0],[1,0],[2,0]]

[match("a+?"; "g") | [.offset, .length]]
"aa"
[[0,1],[1,1]]

[match("a*"; "gn") | [.offset, .length]]
"baab"
[[1,2]]

[test(""; "n"), test("a*"; "n"), test("a"; "n")]
"b"
[false,false,false]

# Spec 13 (Regex row): $ matches only at the end of the input; jq 1.8.2 gives [true,true,false,false].
[.[] | test("^a$")]
["a", "a\n", "\na", "ba"]
[true,false,false,false]

[match("a$"; "g") | .offset]
"a\na"
[2]

[match("^a"; "g") | .offset]
"aa"
[0]

[match("\\bfoo\\b"; "g") | .offset]
"foo foobar foo_ (foo)"
[0,17]

[match("\\Bo\\B"; "g") | .offset]
"foo boo"
[1,5]

# Spec 13 (Regex row): ASCII \d; jq 1.8.2 gives [true,true,false].
[.[] | test("\\d")]
["٣", "3", "a"]
[false,true,false]

# Spec 13 (Regex row): ASCII \w; jq 1.8.2 gives [true,true,false].
[.[] | test("\\w")]
["é", "_", "-"]
[false,true,false]

# Spec 13 (Regex row): ASCII \s; jq 1.8.2 gives [true,true,true,true].
[.[] | test("\\s")]
[" ", "\u000b", " ", " "]
[false,true,false,true]

[.[] | test("^.$")]
["\n", "\r", "😀", "a"]
[false,true,true,true]

[.[] | test("^.$"; "s"), test("^.$"; "m"), test("^.$"; "p")]
["\n"]
[false,true,true]

# The i flag folds ASCII letters only (spec 13 lists the difference: jq 1.8.2 folds the Kelvin
# sign U+212A to k and gives [true,true,false,false]).
[test("K"; "i"), test("k"; "i"), test("ß"; "i"), test("SS"; "i")]
"\u212a"
[false,false,false,false]

# Spec 13: no folding of non-ASCII letters; jq 1.8.2 gives [false,true,false].
[test("ss"; "i"), test("é"; "i"), test("[a-z]"; "i")]
"É"
[false,false,false]

[match("[😀-😂]+") | [.offset, .length, .string]]
"a😁😀b"
[[1,2,"😁😀"]]

[match("[^a]"; "g") | .string]
"a😀b"
["😀","b"]

[match("\\D+") | .string]
"12😀ab3"
["😀ab"]

[match("a b # comment\nc"; "x") | .string]
"abc"
["abc"]

[match("[ #]"; "x") | .string]
"a b#"
[" "]

[test("a\\x41"), test("\\t"), test("\\/"), test("\\-"), test("[\\]]"), test("[a\\-z]")]
"aA\t/-]"
[true,true,true,true,true,true]

# Spec 13 (Regex row): everything outside the flavor of 9.10 is an error; jq 1.8.2 (Oniguruma) accepts most of these.
[.[] | try test(.) catch "ERR"]
["\\A", "\\z", "\\Z", "\\G", "\\K", "\\Qa\\E", "\\0", "\\1", "(a)\\1", "\\cA", "\\u0041", "\\x{41}", "\\p{L}", "[[:alpha:]]", "(?i)a", "(?>a)", "a++", "a*+", "(?<=a)b", "(?!a)", "a{", "a}", "]", "x{1001}", "x{2,1}", "\\e", "\\a", "\\h", "\\o", "(?P<n>a)", "(?<1n>a)", "(?<n>a)(?<n>b)", "[z-a]", "[a", "a)", "*a", "a**", "\\", "[\\d-z]", "x{1000}", "x{,3}", "x{3,}"]
["ERR","ERR","ERR","ERR","ERR","ERR","ERR","ERR","ERR","ERR","ERR","ERR","ERR","ERR","ERR","ERR","ERR","ERR","ERR","ERR","ERR","ERR","ERR","ERR","ERR","ERR","ERR","ERR","ERR","ERR","ERR","ERR","ERR","ERR","ERR","ERR","ERR","ERR","ERR",false,"ERR",false]

[.[] | try test("b") catch "ERR"]
["abc"]
[true]

[match("(?<a>x)(y)(?<b>z)") | .captures[] | .name]
"xyz"
["a",null,"b"]

capture("(?<a>x)(?<n>q)?")
"x"
{"a":"x","n":null}

[scan("c")], [scan("(a)(b)?")], [scan("x"; "g")]
"abcabc"
["c","c"]
[["a","b"],["a","b"]]
[]

[splits("a"; "g")], split(", *"; null), [splits("")]
"xaya, b"
["x","y",", b"]
["xaya","b"]
["","x","a","y","a",","," ","b",""]

"aB" | [sub("(?<a>.)"; "\(.a | ascii_upcase)", "\(.a | ascii_downcase)")]
null
["AB","aB"]

# When str has fewer outputs at some matches, the i-th result skips the matches without an i-th
# output, and their gaps too.
[gsub("(?<x>.)"; if .x == "b" then empty elif .x == "a" then "1", "2" else "3" end)], [gsub("(?<x>.)"; if .x == "a" then "1" else "2", "3" end)]
"abc"
["13","2"]
["122","33"]

[gsub("b"; null)], [gsub("b"; empty)], (try gsub("b"; 1) catch .), (try (1 | split("a"; null)) catch .)
"abc"
["ac"]
["abc"]
"string (\"a\") and number (1) cannot be added"
"number (1) cannot be matched, as it is not a string"

[gsub("😀"; "é"), sub("b"; "😀😀"), split("b"; null), split("😀"; null), gsub("(?<x>b)"; "<\(.x)>")]
"a😀b😀c"
["aébéc","a😀😀😀😀c",["a😀","😀c"],["a","b","c"],"a😀<b>😀c"]

[sub("(?<x>a)"; "<\(.x)>"; "g"), gsub("(?<x>a)|b"; "[\(.x)]"), gsub("(?<d>\\d)"; "\(.d|tonumber+1)"), gsub("^"; ">"), gsub("$"; "<"), sub("a"; "b", "c"; "g")]
"a1ba2"
["<a>1b<a>2","[a]1[null][a]2","a2ba3",">a1ba2","a1ba2<","b1bb2","c1bc2"]

# Spec 13 (Regex empty matches): the search moves by code points after an empty match, 6 empty
# matches in 5 code points; jq 1.8.2 moves by bytes and gives 14.
[match("é😀"; "g") | [.offset, .length]], [match("b") | .offset], (sub("😀"; "x")), ([match(""; "g")] | length)
"é😀é😀b"
[[0,2],[2,2]]
[4]
"éxé😀b"
6

[test("a{3}"), test("a{2,}"), test("^a{1,2}$"), test("a{0}b")]
"aaab"
[true,true,false,true]

[match("a{2,3}?") | .length], [match("a??") | .length], [match("(a|ab)(c|bcd)(d*)") | .string]
"aaaabcd"
[2]
[0]
["abcd"]

[match("x*"; "g") | [.offset, .length]]
"axxb"
[[0,0],[1,2],[3,0],[4,0]]

# Spec 13 (Regex \v): \v is U+000B; jq 1.8.2 gives false for test("\\v").
[test("\\Sx\\W"), test("[\\s\\d]"), test("[^\\w]"), test("\\v"), test("\\f"), test("\\r"), test("\\n")]
"ax- \u000b\f\r\n"
[true,true,true,true,true,true,true]

[match("[😀-😂]"; "g") | .string]
"😀😁😂😃"
["😀","😁","😂"]

[match("[^😀]"; "g") | .string]
"😀a😁"
["a","😁"]

[test("[^a]"; "i"), test("[^b]"; "i")]
"A"
[false,true]

[match("."; "g") | .string], [match("."; "gm") | .string]
"a\n😀"
["a","😀"]
["a","\n","😀"]

[match("a{2}?"; "g") | .length]
"aaa"
[2]

[match("(a|ab)(b?)") | .captures[].string]
"ab"
