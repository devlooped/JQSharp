# Spec 9.12 computed independently of the implementation (the formulas of the spec in Python, checked
# against Python's calendar), where jq 1.8.2 on Windows depends on the C library (spec 13, Dates row).

# Spec 13 (Dates row): own calendar, negative and fractional times floored; jq 1.8.2 on Windows fails
# on negative times.
[.[] | gmtime]
[0,1425599507,-1,-86400.5,1.5,951782400,253402300799,-62135596800,4102444800,1078012800]
[[1970,0,1,0,0,0,4,0],[2015,2,5,23,51,47,4,63],[1969,11,31,23,59,59,3,364],[1969,11,30,23,59,59.5,2,363],[1970,0,1,0,0,1.5,4,0],[2000,1,29,0,0,0,2,59],[9999,11,31,23,59,59,5,364],[1,0,1,0,0,0,1,0],[2100,0,1,0,0,0,5,0],[2004,1,29,0,0,0,0,59]]

# Spec 13 (Dates row): any integer year, missing elements are 0, out-of-range fields roll over;
# jq 1.8.2 on Windows fails on some of these.
[.[] | mktime]
[[2015,2,5,23,51,47,4,63],[2015,14,1,0,0,0,0,0],[2015,2,5],[1969,11,31,23,59,59,0,0],[2015,-1,1,0,0,0],[2015.7,2.9,5.9,23.9,51.9,47.9],[2016,1,30,0,0,0],[2015,0,0,24,60,60],[-1,0,1],[0,0,1],[10000,0,1],[],[2015,0,1,0,0,-1],[2015,0,1,-1,0,0],[1970,0,1,0,0,0.5],[1970,0,1,0,0,-0.5]]
[1425599507,1456790400,1425513600,-1,1417392000,1425599507,1456790400,1420074060,-62198755200,-62167219200,253402300800,-62167305600,1420070399,1420066800,0,0]

# Spec 13 (Dates row): gmtime floors negative fractional seconds (-0.5 is 23:59:59 of the day before).
[.[] | todate]
[0,1425599507,-1,951782400,1.9,-0.5]
["1970-01-01T00:00:00Z","2015-03-05T23:51:47Z","1969-12-31T23:59:59Z","2000-02-29T00:00:00Z","1970-01-01T00:00:01Z","1969-12-31T23:59:59Z"]

