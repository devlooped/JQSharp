# From the evidence of the jqlite plan.
[range(40) | {a: (. % 3), b: .}] | sort_by(.a) | map(.b)
null
[0,3,6,9,12,15,18,21,24,27,30,33,36,39,1,4,7,10,13,16,19,22,25,28,31,34,37,2,5,8,11,14,17,20,23,26,29,32,35,38]

# From the evidence of the jqlite plan.
[range(40) | {a: (. % 3), b: .}] | group_by(.a) | map(map(.b))
null
[[0,3,6,9,12,15,18,21,24,27,30,33,36,39],[1,4,7,10,13,16,19,22,25,28,31,34,37],[2,5,8,11,14,17,20,23,26,29,32,35,38]]

# From the evidence of the jqlite plan.
[range(40) | {a: (. % 3), b: .}] | unique_by(.a) | map(.b)
null
[0,1,2]

# From the evidence of the jqlite plan.
[range(40) | {a: (. % 3), b: .}] | min_by(.a), max_by(.a)
null
{"a":0,"b":0}
