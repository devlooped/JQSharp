# paths.test - Path expressions, assignment and update operators, `paths`.
# Format and comparison rule: see README.md.

.foo |= .+1
{"foo":42}
{"foo":43}

.[] |= .+1
[1,2,3]
[2,3,4]

. |= .+1
41
42

.foo = "bar"
{"foo":1}
{"foo":"bar"}

.foo = .bar
{"foo":1,"bar":2}
{"foo":2,"bar":2}

.[] = 1
[4,5,6]
[1,1,1]

.[] += 2
[1,2,3]
[3,4,5]

.[] -= 2
[5,6,7]
[3,4,5]

.[] *= 2
[1,2,3]
[2,4,6]

.[] /= 2
[2,4,6]
[1,2,3]

.[] %= 2
[1,2,3]
[1,0,1]

.foo //= "default"
{"foo":null}
{"foo":"default"}

.foo //= "default"
{"foo":"value"}
{"foo":"value"}

(.a, .b) |= .+1
{"a":1,"b":2}
{"a":2,"b":3}

(.[] | select(. >= 2)) |= . * 10
[1,2,3]
[1,20,30]

(.[] | select(. < 2)) |= empty
[0,1,2,3]
[2,3]

.[2][3] = 1
[4]
[4,null,[null,null,null,1]]

.foo[1].bar = "x"
{}
{"foo":[null,{"bar":"x"}]}

[paths]
{"a":{"b":1}}
[["a"],["a","b"]]

[paths]
[1,[2]]
[[0],[1],[1,0]]

[paths]
null
[]

# From the evidence of the jqlite plan.
.a += (1,2)
{"a":0}
{"a":1}
{"a":2}

# Path mode (spec §8.1) and its three errors.
path(.a[1:2])
null
["a",{"start":1,"end":2}]

[path(..)]
{"a":[1]}
[[],["a"],["a",0]]

path(.[] | select(.a))
[{"a":1}]
[0]

[path(first(.a, .b))]
null
[["a"]]

[path(limit(2; .[]))]
[1,2,3]
[[0],[1]]

try path(1) catch .
null
"Invalid path expression with result 1"

try path(1 | .a) catch .
{}
"Invalid path expression near attempt to access element \"a\" of 1"

try path(1 | .[]) catch .
{}
"Invalid path expression near attempt to iterate through 1"

try path(getpath(["a","b"])) catch .
{"a":1}
"Cannot index number with string (\"b\")"

[(.a, .b) = range(2)]
{}
[{"a":0,"b":0},{"a":1,"b":1}]

[1,5,3,0,7] | (.[] | select(. >= 2)) |= empty
null
[1,0]

del(.[1,2])
[1,2,3,4]
[1,4]

.a //= 3
{"a":null}
{"a":3}

# tostream, fromstream, truncate_stream (spec 9.5).
[tostream]
{"a":[1,{"b":2}],"c":[]}
[[["a",0],1],[["a",1,"b"],2],[["a",1,"b"]],[["a",1]],[["c"],[]],[["c"]]]

fromstream(tostream)
{"a":[1,{"b":2}],"c":[]}
{"a":[1,{"b":2}],"c":[]}

[.[] | [tostream]]
[null, [], {}, [[]], "x", {"a":{}}]
[[[[],null]],[[[],[]]],[[[],{}]],[[[0],[]],[[0]]],[[[],"x"]],[[["a"],{}],[["a"]]]]

[.[] | fromstream(tostream)]
[null, [], {}, [[]], "x", {"a":{}}, [1,[2,[3]]]]
[null,[],{},[[]],"x",{"a":{}},[1,[2,[3]]]]

[1 | truncate_stream([[0],1],[[1,0],2],[[1,0]],[[1]])]
null
[[[0],2],[[0]]]

[2 | truncate_stream([[0],1],[[1,0],2],[[1,0]],[[1]])]
null
[]

[fromstream(1 | truncate_stream([[0],1],[[1,0],2],[[1,0]],[[1]]))]
null
[[2]]

[fromstream(.[] | [[.], .], [[.]])]
[0,1]
[[0],[null,1]]
