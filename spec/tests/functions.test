# Single calls (spec §7.7, §11): a call that yields at most one output has ended when its output
# is used, so the depth of a tree recursion is the depth of the recursion.
def fib: if . < 2 then . else (. - 1 | fib) + (. - 2 | fib) end; fib
20
6765

def fib($n): if $n < 2 then $n else fib($n - 1) + fib($n - 2) end; fib(.)
20
6765

def fib: if . < 0 then error("negative") elif . < 2 then . else (. - 1 | fib) + (. - 2 | fib) end; fib, (try (-1 | fib) catch .)
18
2584
"negative"

def f: if . == 0 then empty elif . < 3 then 1 else (. - 1 | f) + (. - 2 | f) end; [f], [0 | f]
18
[2584]
[]

def t: if . <= 1 then 1 elif any(1, 2; . == 3) then 0 else (. / 2 | floor | t) + (. - (. / 2 | floor) | t) end; t
2048
2048

