# Each math native on ordinary values, NaN, infinities, signed zeros and non-numbers. Library
# functions are rounded inside the program; the exactly specified ones are compared as they are.

try ("a" | floor) catch .
null
"string (\"a\") number required"

try (null | sqrt) catch .
null
"null (null) number required"

try ({} | sin) catch .
null
"object ({}) number required"

try pow("a"; 2) catch .
null
"string (\"a\") number required"

try pow(2; "a") catch .
