# Spec 13 (Dates row): %c, %x and %s by the table of 9.12; jq 1.8.2 on Windows uses the C library.
[.[] | strftime("%c|%x|%X|%n|%t|%z|%Z|%s")]
[0,1425599507,-1,-86400.5]
["Thu Jan  1 00:00:00 1970|01/01/70|00:00:00|\n|\t|+0000|UTC|0","Thu Mar  5 23:51:47 2015|03/05/15|23:51:47|\n|\t|+0000|UTC|1425599507","Wed Dec 31 23:59:59 1969|12/31/69|23:59:59|\n|\t|+0000|UTC|-1","Tue Dec 30 23:59:59 1969|12/30/69|23:59:59|\n|\t|+0000|UTC|-86401"]

