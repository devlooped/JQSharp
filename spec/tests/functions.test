def pick: if has("a") then .a else empty end; [path(pick | pick)], [path(getpath(["b"]) | getpath(["b"]))], [path(.b | pick)]
{"a":{"a":1,"b":2},"b":{"b":3}}
[["a","a"]]
[["b","b"]]
[]

