# variables.test - Variable binding with `as`, and its precedence.
# Format and comparison rule: see README.md.

5 as $x | $x + $x
null
10

1 as $x | 2 as $y | [$x,$y,$x]
null
[1,2,1]

[1,2,3][] as $x | [$x]
null
[1]
[2]
[3]

42 as $x | . | . | . + 432 | $x + 1
34324
43

1 + 2 as $x | -$x
null
-3

"x" as $x | "a"+"y" as $y | $x+","+$y
null
"x,ay"

1 as $x | [$x,$x,$x as $x | $x]
null
[1,1,1]

[-1 as $x | 1,$x]
null
[1,-1]

[1, {c:3, d:4}] as [$a, {c:$b, b:$c}] | $a, $b, $c
null
1
3
null

.[] as [$a, $b] | [$b, $a]
[[1],[1,2,3]]
[null,1]
[2,1]

. as {as: $kw, "str": $str, ("e"+"x"+"p"): $exp} | [$kw, $str, $exp]
{"as":1,"str":2,"exp":3}
[1,2,3]

. as {$a, b: [$c, {$d}]} | [$a, $c, $d]
{"a":1,"b":[2,{"d":3}]}
[1,2,3]

[1,2,3][] as $x | [4,5,6,7][$x]
null
5
6
7

# From the evidence of the jqlite plan.
1, 2 as $x | $x * 10
null
1
20
