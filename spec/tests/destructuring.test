# destructuring.test - Destructuring patterns and the `?//` alternatives.
# Format and comparison rule: see README.md.

.[] | . as {$a, b: [$c, {$d}]} ?// [$a, {$b}, $e] ?// $f | [$a, $b, $c, $d, $e, $f]
[{"a":1, "b":[2,{"d":3}]}, [4, {"b":5, "c":6}, 7, 8, 9], "foo"]
[1,null,2,3,null,null]
[4,5,null,null,7,null]
[null,null,null,null,null,"foo"]

.[] | . as {a:$a} ?// {a:$a} ?// $a | $a
[[3],[4],[5],6]
[3]
[4]
[5]
6

.[] | . as $a ?// {a:$a} ?// {a:$a} | $a
[[3],[4],[5],6]
[3]
[4]
[5]
6

.[] | . as {a:$a} ?// $a ?// {a:$a} | $a
[[3],[4],[5],6]
[3]
[4]
[5]
6

. as {$a} ?// $a | $a
{"a":1}
1

. as {$a} ?// $a | $a
42
42

try (.[] | . as {a:$a} ?// {a:$a} ?// {a:$a} | $a) catch .
[[3],[4],[5],6]
"Cannot index array with string (\"a\")"

# The same variable twice in one pattern: without ?// the first in matching order (array
# elements last to first, object entries first to last) gives the value; with ?// the last does.
. as [$a, $a] | $a
[1,2]
2

. as [$a, [$a, $a]] | $a
[3,[1,2]]
2

. as {$a, b: $a} ?// $c | $a
{"a":1,"b":2}
2

. as {x: $c} ?// [$a, $a] | $a
[1,2]
1

# A key expression runs on the value being matched, in the scope outside the binding.
.[0] as {(.a): $v} | $v
[{"a":"x","x":5}]
5

"b" as $x | . as {a: $x, ($x): $y} | $y
{"a":"c","b":5,"c":7}
5

[.[] as [$a] ?// $a | $a]
[[1],2]
[1,2]

[.[] as [$a] ?// $a | if ($a | type) == "number" then error("n") else $a end]
[[1]]
[[1]]

# A computed pattern key indexes the value with the rules of §7.6, whatever its kind (§7.5).
. as {(.[0] * 0 + 1): $v} | $v
[5,6]
6

try (. as {(.a): $v} | $v) catch .
{"a":1}
"Cannot index object with number (1)"

# An error downstream of a ?// binding is not the binding's (§6.2; §13 lists the difference from jq).
try ((.[] as [$a] ?// $a | $a) | error(tostring)) catch .
[[1]]
"1"
