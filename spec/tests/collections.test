# collections.test - Array and generator builtins: sorting, grouping, `add`, `any`/`all`, `first`/`last`, `range`, SQL-style `INDEX`/`IN`/`JOIN`.
# Format and comparison rule: see README.md.

INDEX(range(5)|[., "foo\(.)"]; .[0])
null
{"0":[0,"foo0"],"1":[1,"foo1"],"2":[2,"foo2"],"3":[3,"foo3"],"4":[4,"foo4"]}

[{"name":"foo","val":1},{"name":"bar","val":2}] | INDEX(.name)
null
{"foo":{"name":"foo","val":1},"bar":{"name":"bar","val":2}}

JOIN({"0":[0,"abc"],"1":[1,"bcd"],"2":[2,"def"],"3":[3,"efg"],"4":[4,"fgh"]}; .[0]|tostring)
[[5,"foo"],[3,"bar"],[1,"foobar"]]
[[[5,"foo"],null],[[3,"bar"],[3,"efg"]],[[1,"foobar"],[1,"bcd"]]]

